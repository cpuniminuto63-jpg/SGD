# Copia este archivo a .env.local y completa con los valores del proyecto Supabase.
# NUNCA subas .env.local al repositorio (ya está en .gitignore).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo para scripts de servidor (importación/exportación, seeds). NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=
