# Copia este archivo a .env.local y completa con los valores reales.
# NUNCA subas .env.local al repositorio (ya está en .gitignore).

# Cadena de conexión a Postgres. Si vinculas una base de datos Vercel Postgres al
# proyecto en el dashboard de Vercel, POSTGRES_URL se inyecta automáticamente en
# producción/preview — solo necesitas definirla aquí para desarrollo local.
POSTGRES_URL=
# Alternativa aceptada por src/lib/db/client.ts si prefieres ese nombre en local.
DATABASE_URL=

# OPCIONAL, y peligrosa si se configura mal: scripts/backup-db.ts y
# scripts/report-sedes-por-dia-persona.ts la usan EN VEZ de POSTGRES_URL si está
# definida (ver "process.env.REPORTS_DB_URL ?? process.env.POSTGRES_URL" en esos
# archivos). Pensada para apuntar esos scripts a una réplica de solo lectura, si
# alguna vez existe una. Si la defines, debe apuntar a LA MISMA base que
# POSTGRES_URL -- dejarla apuntando a una base vieja/distinta hace que los respaldos
# y reportes se generen en silencio contra datos equivocados (ya pasó un incidente de
# este tipo con la conexión principal durante la migración de infraestructura). Si no
# tienes una réplica separada, déjala vacía o sin definir.
REPORTS_DB_URL=

# Clave secreta para firmar las sesiones de NextAuth. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
