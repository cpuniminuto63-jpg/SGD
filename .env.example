# Copia este archivo a .env.local y completa con los valores reales.
# NUNCA subas .env.local al repositorio (ya está en .gitignore).

# Cadena de conexión a Postgres. Si vinculas una base de datos Vercel Postgres al
# proyecto en el dashboard de Vercel, POSTGRES_URL se inyecta automáticamente en
# producción/preview — solo necesitas definirla aquí para desarrollo local.
POSTGRES_URL=
# Alternativa aceptada por src/lib/db/client.ts si prefieres ese nombre en local.
DATABASE_URL=

# Clave secreta para firmar las sesiones de NextAuth. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
